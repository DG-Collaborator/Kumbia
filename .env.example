# Copy to .env and fill in. .env is gitignored; this template is safe to commit.

# --- Elasticsearch (real network data) ---------------------------------
ES_URL=
ES_USERNAME=
ES_PASSWORD=

# network_monitoring persona: where the real (enriched) network data lives.
# Run tools/es_probe.py to see your indices and field names, then set these.
NETWORK_ES_INDEX_PATTERN=*
NETWORK_HOST_FIELD=host.ip
NETWORK_DEST_FIELD=destination.ip
NETWORK_DNS_FIELD=gigamon.ami.dns_name
NETWORK_TIMESTAMP_FIELD=@timestamp
# Extra fields to break traffic down by: alias=field,alias=field. Each alias
# becomes a chat skill (network_breakdown_<alias>). Fields must be
# aggregatable (keyword, ip, numeric, date). Empty = just the DNS field.
NETWORK_BREAKDOWN_FIELDS=
# Numeric fields to report on: alias=field,alias=field. Each alias becomes a
# chat skill (network_metric_<alias>): total/average/min/max/p95, top hosts,
# and peaks over time. Values are reported in the field's own units.
NETWORK_METRIC_FIELDS=
# Metric aliases (from NETWORK_METRIC_FIELDS) every activity report also
# totals, with top hosts by each, e.g. bytes_out,bytes_in.
NETWORK_REPORT_METRICS=
# Window chat questions use when they don't name one ("last 3 days" overrides).
NETWORK_CHAT_HOURS_BACK=24
# Host drilldowns are computed from aggregations; they also pass the host's
# NETWORK_DRILLDOWN_MAX_EVENTS most recent events to the model as evidence,
# with only the fields above plus these extras. "*" = every field (slow).
NETWORK_DRILLDOWN_FIELDS=
NETWORK_DRILLDOWN_MAX_EVENTS=20
# Names for stable addresses (e.g. Kubernetes service ClusterIPs): answers
# show "10.96.0.10 (kube-dns)" and questions can say "kube-dns".
NETWORK_HOST_ALIASES=

# --- Prometheus (compute telemetry) -------------------------------------
PROMETHEUS_URL=
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
TELEMETRY_COMPUTE_INSTANCE=

# --- LLMs --------------------------------------------------------------
OPENAI_API_KEY=
# Assistant (chat) model: openai is recommended — it also routes chat to the
# right data skill, which a small local model does less reliably.
ASSISTANT_LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

TAVILY_API_KEY=

MCP_TRANSPORT=stdio

# --- Telemetry collection (demo cadence) --------------------------------
TELEMETRY_POLL_INTERVAL_SECONDS=30
TELEMETRY_BUCKET_MINUTES=1
# Asset registry: which PDU outlet, network IP (as it appears in
# NETWORK_HOST_FIELD), and Prometheus instance belong to each asset. Copy
# data/telemetry/assets.example.json to data/telemetry/assets.json and edit;
# one entry per asset. When the file doesn't exist, one asset (FBA-1, outlet
# R42-U18) is used, with the two settings below as its IP and instance.
# TELEMETRY_ASSETS_PATH=data/telemetry/assets.json
TELEMETRY_NETWORK_HOST_IP=
# (TELEMETRY_COMPUTE_INSTANCE above is the fallback asset's instance.)
# TELEMETRY_ES_INDEX_PATTERN=
# TELEMETRY_NETWORK_HOST_FIELD=
# Network metrics (aliases from NETWORK_METRIC_FIELDS) carried per time
# bucket next to power and CPU, so the correlated report can relate them:
# alias[:sum|avg|max], e.g. bytes_out,bytes_in,tcp_rtt:avg. Defaults to
# NETWORK_REPORT_METRICS, summed.
# TELEMETRY_NETWORK_METRICS=

# --- Power telemetry ----------------------------------------------------
# sqlite file of power readings; create/fill it with
#   python tools/telemetry_sim/power_backfill.py --days 7
# POWER_TELEMETRY_DB_PATH=power_telemetry.sqlite
# Named in every power answer, so synthetic data is never mistaken for real.
POWER_TELEMETRY_SOURCE_SYSTEM=synthetic_dcim
